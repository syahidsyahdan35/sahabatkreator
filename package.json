{
  "name": "sahabat-kreator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sahabat-kreator/api --filter @sahabat-kreator/web dev",
    "dev:api": "pnpm --filter @sahabat-kreator/api dev",
    "dev:web": "pnpm --filter @sahabat-kreator/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "echo \"lint: TODO eslint + i18n no-literal-string (RANCANGAN \u00a711.1)\""
  }
}
