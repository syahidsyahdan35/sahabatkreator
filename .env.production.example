# =============================================================================
# .env.production — TEMPLATE nama saja (Fase 14C, docs/PRODUCTION.md)
# Salin ke server produksi sebagai /home/ubuntu/sahabat-kreator/.env.production
# (chmod 600) dan isi nilainya DI SERVER — nilai asli tidak pernah masuk
# repo, chat, atau log. Rotasi & pemilik tiap rahasia: docs/SECRETS-RUNBOOK.md.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
API_PORT=3101
REALTIME_PORT=3103
# Ambang log terstruktur JSON (debug|info|warn|error). Produksi: info.
LOG_LEVEL=info

# --- Database (container pg produksi; dua role seperti staging) -------------
# Koneksi aplikasi (role NON-superuser, tanpa BYPASSRLS — RLS berlaku):
DATABASE_URL=
# Koneksi migrasi (role pemilik). Dipakai HANYA saat migrate:
#   DATABASE_URL=$MIGRATION_DATABASE_URL pnpm db:migrate
MIGRATION_DATABASE_URL=

# --- Auth --------------------------------------------------------------------
# Secret penandatanganan sesi Better Auth (acak ≥32 byte). Merotasinya
# mengeluarkan SEMUA pengguna — lihat SECRETS-RUNBOOK.
BETTER_AUTH_SECRET=
# URL publik produksi (https://<domain>) — dasar callback OAuth Meta/Google,
# tautan /pay, dan tautan email reset:
BETTER_AUTH_URL=

# --- Kunci induk enkripsi (acak base64 32 byte; JANGAN dirotasi sembarangan —
# merotasi tanpa re-enkripsi membuat seluruh kredensial tersimpan tak terbaca)
CHANNEL_TOKEN_SECRET=
# <redacted>
PLATFORM_SETTINGS_SECRET=

# --- Platform ----------------------------------------------------------------
# Allowlist email admin platform (koma-terpisah). Email pertama yang
# mendaftar dengan alamat di daftar ini menjadi admin platform:
PLATFORM_ADMIN_EMAILS=
# HMAC token sesi pengunjung webchat (acak ≥16 char):
WEBCHAT_SECRET=
# Redis antrean BullMQ + pub/sub realtime (container proyek sendiri):
REDIS_URL=redis://127.0.0.1:6381

# --- R2 (bucket produksi WAJIB eksplisit — default kode adalah bucket
# staging; kunci aksesnya sendiri di Panel Admin, env hanya fallback) --------
R2_BUCKET=sahabat-kreator-prod

# --- Provider LLM -------------------------------------------------------------
# Kunci OpenRouter sumber utamanya Panel Admin; env hanya fallback.
LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# EMBEDDING_PROVIDER=

# --- Fallback env untuk kunci Panel Admin (panel adalah sumber utama; ------
# baris-baris ini hanya dipakai bila panel kosong untuk kunci itu) -----------
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_APP_ID=
# META_IG_CONFIG_ID=
# META_WA_CONFIG_ID=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_FROM_NAME=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Override base URL provider (HANYA untuk uji mock; produksi dikosongkan)
# TELEGRAM_API_BASE=
# META_API_BASE=
# RESEND_API_BASE=
# MIDTRANS_API_BASE=
# XENDIT_API_BASE=
# GOOGLE_API_BASE=
# GOOGLE_TOKEN_BASE=
# GOOGLE_AUTH_BASE=
# AGENT_BATCH_WINDOW_MS=
