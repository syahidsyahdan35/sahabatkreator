# Contoh konfigurasi lokal — salin ke .env, JANGAN commit .env asli.
# Tidak ada nilai rahasia asli di file ini.
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173

# Lokal via docker-compose.yml di root repo:
DATABASE_URL=postgres://sahabat:sahabat@localhost:5432/sahabat_kreator
REDIS_URL=redis://localhost:6379

# Better Auth (Fase 1B) — secret acak >=32 karakter, URL publik aplikasi.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# AI provider (pengembangan): OpenRouter free tier — isi di .env lokal saja.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Meta Graph API — versi ter-pin (RANCANGAN §12.1). Jangan ubah tanpa cek changelog Meta.
META_GRAPH_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=

# Cloudflare R2 (storage) — per lingkungan, jangan commit nilainya.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
