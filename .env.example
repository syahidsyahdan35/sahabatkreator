# Contoh konfigurasi lokal — salin ke .env, JANGAN commit .env asli.
# Tidak ada nilai rahasia asli di file ini.
#
# Catatan: di NODE_ENV=production API MENOLAK BOOT bila salah satu kunci
# bertanda [wajib-produksi] belum diisi (lihat packages/config).
NODE_ENV=development
API_PORT=3001
WEB_PORT=5173
REALTIME_PORT=3103

# Lokal via docker-compose.yml di root repo:
DATABASE_URL=postgres://sahabat:sahabat@localhost:5432/sahabat_kreator
# Redis dipakai antrean BullMQ, pub/sub realtime, sesi OAuth Meta, DAN
# penghitung rate limit auth (Fase 13D). Tanpa REDIS_URL, rate limit
# kembali ke in-memory per proses (cukup untuk dev, salah untuk multi-replika).
REDIS_URL=redis://localhost:6379

# Better Auth (Fase 1B) — secret acak >=32 karakter, URL publik aplikasi.
# [wajib-produksi]
BETTER_AUTH_SECRET=
# [wajib-produksi]
BETTER_AUTH_URL=http://localhost:3001

# Enkripsi kredensial channel (Fase 6A) — base64 dari 32 byte acak
# (AES-256-GCM untuk token bot/page). Juga dipakai mengunci token undangan.
# [wajib-produksi]
CHANNEL_TOKEN_SECRET=

# Webchat (Fase 1F) — secret HMAC untuk token sesi pengunjung widget (>=16 karakter).
# [wajib-produksi]
WEBCHAT_SECRET=

# Panel Admin Platform (Fase 6C) — kunci induk enkripsi nilai platform_settings.
# [wajib-produksi]
PLATFORM_SETTINGS_SECRET=
# Allowlist email admin platform, koma-terpisah (kosong = panel terkunci).
PLATFORM_ADMIN_EMAILS=

# AI provider (pengembangan): OpenRouter free tier — isi di .env lokal saja.
# LLM_PROVIDER: mock (default, tanpa biaya) | openrouter
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Embedding KB (Fase 12D): kosong = auto (aktif bila kunci OpenRouter ada),
# mock | openrouter.
EMBEDDING_PROVIDER=
OPENROUTER_EMBEDDING_MODEL=
# Jendela batching balasan agent (ms); 0 = tanpa penundaan.
AGENT_BATCH_WINDOW_MS=5000

# Meta Graph API — versi ter-pin (RANCANGAN §12.1). Jangan ubah tanpa cek changelog Meta.
META_GRAPH_API_VERSION=v26.0
# Override base URL hanya untuk mock lokal.
META_API_BASE=
META_APP_ID=
META_IG_CONFIG_ID=
META_WA_CONFIG_ID=
# [wajib untuk webhook Meta] Secret App + verify token handshake.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Telegram Bot API — override base URL hanya untuk mock lokal.
TELEGRAM_API_BASE=

# Cloudflare R2 (storage) — per lingkungan, jangan commit nilainya.
# Sumber utama kredensial adalah Panel Admin; env hanya fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email transaksional Resend (Fase 11B) — sumber utama Panel Admin, env fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_API_BASE=
